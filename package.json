{
  "name": "@10planet-l1/deva-sdk",
  "version": "0.1.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/10Planet-L1/deva-sdk.git"
  },
  "scripts": {
    "build": "vite build",
    "dev:install": "pnpm install --frozen-lockfile && cd example && pnpm install --frozen-lockfile",
    "dev:example": "cd example && pnpm run dev",
    "dev": "NODE_ENV=development vite build --watch",
    "example": "cd example && pnpm run dev",
    "example:link": "cd example && pnpm link ../",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "main": "dist/index.es.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.es.js"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/assets/deva-sdk.css",
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.es.js",
      "require": "./dist/components.es.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@remirror/pm": "^3.0.0",
    "@remirror/react": "^3.0.1",
    "@tanstack/react-query": "^5.50.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "framer-motion": "^12.5.0",
    "geist": "^1.3.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.474.0",
    "openapi-fetch": "^0.13.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remirror": "^3.0.1",
    "superjson": "^2.2.1",
    "swr": "^2.3.0",
    "swr-openapi": "^5.1.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "validator": "^13.12.0",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/validator": "^13.12.2",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.1",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.3",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "packageManager": "pnpm@9.6.0"
}
